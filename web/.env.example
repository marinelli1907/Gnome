# Gnome web (public site) — copy to .env.local and fill in.
# Public anon values only (same Supabase project as the app). Safe in the client.
NEXT_PUBLIC_SUPABASE_URL=https://fgybyghwcjlstqxkclch.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Store URLs for the "Get the app" / "Open in Gnome" hand-off.
# Set each ONLY to the app's own product page, and only once the app is really
# published there. A generic store URL is worse than an empty one: it tells a
# visitor the app is downloadable when it is not.
# iOS: still the App Store home page — replace with the real
#      https://apps.apple.com/us/app/<slug>/id<appleId> before launch.
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/
# Android: EMPTY ON PURPOSE — Gnome has no Google Play listing yet, so nothing
# on the site may link to Play. Fill in after the Play release, not before.
NEXT_PUBLIC_ANDROID_APP_URL=
